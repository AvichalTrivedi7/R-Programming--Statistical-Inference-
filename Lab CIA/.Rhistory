# For unbiasedness we need Expectation of Statistic equal to the Parameter of Population. Hence, we first create samples
all_samples_possible=choose(25,5)
all_samples_possible
n=5
set.seed(12)
sampDist <- replicate(all_samples_possible, mean(sample(population$clock_speed, n)))
# Expected value of the estimate
mean(sampDist)
## Trying more with greater n values
##1
n <- 10
set.seed(12)
sampDist10 <- replicate(1000, mean(sample(population$clock_speed, n)))
mean(sampDist10)
##2
n <- 20
set.seed(12)
