x <- mtcars$hp
sample_means_hp <- replicate(1000, mean(sample(x, size = 4, replace = TRUE)))
hist(sample_means_hp,
main = "Sampling Distribution of Mean (hp)",
xlab = "Sample Mean",
col = "lightpink")
