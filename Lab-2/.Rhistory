summarise(Count = n())
ggplot(release_trend, aes(x = release_year, y = Count)) +
geom_line(color = "blue", size = 1.2) +
ggtitle("Netflix Content Released Over the Years") +
xlab("Release Year") + ylab("Number of Titles") +
theme_minimal()
